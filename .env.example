# Database
# MySQL DSN format: user:password@tcp(host:port)/dbname?parseTime=true
READ_DATABASE_URL=root:password@tcp(localhost:3306)/grandshipper?parseTime=true
WRITE_DATABASE_URL=root:password@tcp(localhost:3306)/grandshipper?parseTime=true

# Server
PORT=8080

# Auth
JWT_KEY=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=8h
SESSION_SECRET=32-byte-random-secret-change-this!

# CORS (comma-separated, supports 'regexp:' prefix)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Stripe (optional – required for /api/get-total-billed)
STRIPE_SECRET=sk_test_...

# GraphQL debug (optional)
GQL_DB_DEBUG=false
GRAPHIQL=false

# AWS (optional – required if labels are stored on S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
