package pages

import (
	"fmt"
	"time"
	"github.com/danegigi/go-tut/internal/models"
	"github.com/danegigi/go-tut/internal/views/layouts"
)

type AccountDetailData struct {
	User       *models.User
	Activities []models.AdminActivity
	Flash      string
}

// AccountDetailShell renders instantly using only the account ID (from the URL,
// no DB query). The info card and activity feed lazy-load their own data.
templ AccountDetailShell(id uint, flash string) {
	@layouts.Dashboard("Account") {
		if flash != "" {
			<div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3">{ flash }</div>
		}
		<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
			<!-- Left: user info card (lazy) + password card (no DB) -->
			<div class="lg:col-span-2 space-y-6">
				@layouts.LazySection("account-info", fmt.Sprintf("/accounts/%d/info", id))
				@changePasswordCard(id, "account")
			</div>
			<!-- Right: activity feed (lazy) -->
			<div class="space-y-6">
				@layouts.LazySection("account-activities", fmt.Sprintf("/accounts/%d/activities", id))
			</div>
		</div>
	}
}

// AccountInfoFragment renders the info card + actions card. Root id matches the
// LazySection placeholder so Datastar swaps the right node.
templ AccountInfoFragment(u *models.User) {
	<div id="account-info" class="space-y-6">
		@userInfoCard(u)
		@accountActionsCard(u)
	</div>
}

// AccountActivitiesFragment renders the activity feed.
templ AccountActivitiesFragment(activities []models.AdminActivity, userID uint) {
	<div id="account-activities">
		@activitiesCard(activities, userID)
	</div>
}

templ userInfoCard(u *models.User) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
		<div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
			<h2 class="text-sm font-semibold text-gray-700">Account Information</h2>
			<a href={ templ.URL(fmt.Sprintf("/accounts/%d/edit", u.ID)) }
				class="text-xs text-indigo-600 hover:text-indigo-800 font-medium">Edit</a>
		</div>
		<dl class="px-5 py-4 grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
			@infoRow("Name", u.Name)
			@infoRow("Email", u.Email)
			@infoRow("Company", strOrDash(u.Company))
			@infoRow("Phone", strOrDash(u.Phone))
			@infoRow("Rep ID", strOrDash(u.RepID))
			@infoRow("Title", strOrDash(u.Title))
			@infoRow("District", strOrDash(u.District))
			@infoRow("Address", formatAddress(u))
			@infoRow("Plan Price", formatMoney(u.PlanPrice))
			@infoRow("Postage Balance", formatMoney(u.PostageBalance))
			@infoRow("Shipsurance Balance", formatMoney(u.ShipsuranceBalance))
			@infoRow("Created", fmtTime(u.CreatedAt))
			@infoRow("Last Login", fmtTime(u.LastLogin))
		</dl>
	</div>
}

templ infoRow(label, value string) {
	<div>
		<dt class="text-xs text-gray-400 uppercase tracking-wide">{ label }</dt>
		<dd class="mt-0.5 font-medium text-gray-800">{ value }</dd>
	</div>
}

templ changePasswordCard(userID uint, kind string) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
		<div class="px-5 py-4 border-b border-gray-100">
			<h2 class="text-sm font-semibold text-gray-700">Change Password</h2>
		</div>
		<div class="px-5 py-4"
			data-store='{"newPwd":"","confirm":"","msg":"","err":""}'
			data-on-submit__prevent="@post('/api/change-password')"
			id={ fmt.Sprintf("pwd-form-%d", userID) }>
			<form method="post" action={ templ.URL(fmt.Sprintf("/accounts/%d/change-password", userID)) }
				class="flex flex-col gap-3">
				<input type="hidden" name="kind" value={ kind }/>
				<input type="hidden" name="user_id" value={ fmt.Sprintf("%d", userID) }/>
				<div>
					<label class="block text-xs font-medium text-gray-600 mb-1">New Password</label>
					<input type="password" name="new_password" required
						class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-gray-600 mb-1">Confirm Password</label>
					<input type="password" name="confirm_password" required
						class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"/>
				</div>
				<button type="submit"
					class="self-start px-4 py-2 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition-colors">
					Update Password
				</button>
			</form>
		</div>
	</div>
}

templ accountActionsCard(u *models.User) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
		<div class="px-5 py-4 border-b border-gray-100">
			<h2 class="text-sm font-semibold text-gray-700">Actions</h2>
		</div>
		<div class="px-5 py-4 space-y-2">
			<!-- Favorite toggle -->
			<form method="post" action={ templ.URL(fmt.Sprintf("/accounts/%d/favorite", u.ID)) }>
				<input type="hidden" name="favorite" value={ boolToggleStr(!u.Favorite) }/>
				<button type="submit"
					class="w-full text-left text-sm px-3 py-2 rounded-lg border border-gray-200 hover:bg-yellow-50 hover:border-yellow-300 transition-colors flex items-center gap-2">
					if u.Favorite {
						<svg class="w-4 h-4 text-yellow-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
						Remove from Favorites
					} else {
						<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
						Add to Favorites
					}
				</button>
			</form>
			<!-- Suspend toggle -->
			<form method="post" action={ templ.URL(fmt.Sprintf("/accounts/%d/suspend", u.ID)) }>
				<input type="hidden" name="suspend" value={ boolToggleStr(!u.Suspend) }/>
				<button type="submit"
					class="w-full text-left text-sm px-3 py-2 rounded-lg border border-gray-200 hover:bg-red-50 hover:border-red-300 transition-colors">
					if u.Suspend {
						Unsuspend Account
					} else {
						Suspend Account
					}
				</button>
			</form>
		</div>
	</div>
}

templ activitiesCard(activities []models.AdminActivity, userID uint) {
	<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
		<div class="px-5 py-4 border-b border-gray-100">
			<h2 class="text-sm font-semibold text-gray-700">Activity Notes</h2>
		</div>
		<!-- Add note form -->
		<div class="px-5 pt-4">
			<form method="post" action={ templ.URL(fmt.Sprintf("/accounts/%d/activity", userID)) }
				class="flex gap-2">
				<input type="text" name="note" placeholder="Add a note…"
					class="flex-1 px-3 py-1.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"/>
				<button type="submit"
					class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition-colors">Add</button>
			</form>
		</div>
		<!-- Activity list -->
		<div class="px-5 py-4 space-y-3 max-h-64 overflow-y-auto">
			for _, a := range activities {
				<div class="text-xs text-gray-600 border-l-2 border-indigo-200 pl-3">
					<p class="font-medium text-gray-800">{ a.Note }</p>
					<p class="text-gray-400 mt-0.5">{ a.AdminName } · { a.CreatedAt.Format("Jan 2, 2006 3:04 PM") }</p>
				</div>
			}
			if len(activities) == 0 {
				<p class="text-xs text-gray-400 text-center py-4">No activity notes yet.</p>
			}
		</div>
	</div>
}

func boolToggleStr(v bool) string {
	if v {
		return "true"
	}
	return "false"
}

func formatMoney(v *float64) string {
	if v == nil {
		return "—"
	}
	return fmt.Sprintf("$%.2f", *v)
}

func formatAddress(u *models.User) string {
	parts := []string{}
	if u.Address != nil && *u.Address != "" {
		parts = append(parts, *u.Address)
	}
	if u.City != nil && *u.City != "" {
		parts = append(parts, *u.City)
	}
	if u.State != nil && *u.State != "" {
		parts = append(parts, *u.State)
	}
	if u.PostalCode != nil && *u.PostalCode != "" {
		parts = append(parts, *u.PostalCode)
	}
	if len(parts) == 0 {
		return "—"
	}
	result := ""
	for i, p := range parts {
		if i > 0 {
			result += ", "
		}
		result += p
	}
	return result
}

func fmtTime(t *time.Time) string {
	if t == nil {
		return "—"
	}
	return t.Format("Jan 2, 2006")
}
