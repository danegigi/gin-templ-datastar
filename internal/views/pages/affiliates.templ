package pages

import (
	"fmt"
	"net/url"
	"github.com/grandshipper/admin-v2/internal/models"
	"github.com/grandshipper/admin-v2/internal/views/layouts"
)

// listURL builds a fragment URL with an optional ?q= search param, safely escaped.
func listURL(base, search string) string {
	if search == "" {
		return base
	}
	return base + "?q=" + url.QueryEscape(search)
}

type AffiliatesData struct {
	Users      []models.User
	TotalItems int64
	Page       int
	Limit      int
	Search     string
}

templ Affiliates(d AffiliatesData) {
	@layouts.Dashboard("Affiliates") {
		<div class="mb-4 flex items-center justify-between">
			<span class="text-sm text-gray-500">Affiliates</span>
			<div class="flex gap-2">
				<a href="/affiliates/create"
					class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition-colors">
					+ Create Affiliate
				</a>
				<form method="get" action="/affiliates">
					<input type="text" name="q" value={ d.Search } placeholder="Search…"
						class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm w-52 focus:outline-none focus:ring-2 focus:ring-indigo-400"/>
				</form>
			</div>
		</div>
		@layouts.LazySection("affiliates-list", listURL("/affiliates/list", d.Search))
	}
}

// AffiliatesListFragment is the lazily-loaded table for the affiliates page.
templ AffiliatesListFragment(d AffiliatesData) {
	<div id="affiliates-list" class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
		<div class="px-5 py-3 border-b border-gray-100 text-sm text-gray-500">{ fmt.Sprintf("%d affiliates", d.TotalItems) }</div>
		@userListTable(d.Users, "affiliates")
		@Pagination("/affiliates", d.Page, d.Limit, d.TotalItems, d.Search)
	</div>
}

templ CreateAffiliate(flash, errMsg string) {
	@layouts.Dashboard("Create Affiliate") {
		<div class="max-w-lg">
			<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
				<div class="px-5 py-4 border-b border-gray-100">
					<h2 class="text-sm font-semibold text-gray-700">New Affiliate</h2>
				</div>
				if errMsg != "" {
					<div class="mx-5 mt-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">{ errMsg }</div>
				}
				if flash != "" {
					<div class="mx-5 mt-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3">{ flash }</div>
				}
				<form method="post" action="/affiliates/create" class="px-5 py-4 space-y-4">
					@formField("Name", "name", "text", "", true)
					@formField("Email", "email", "email", "", true)
					@formField("Password", "password", "password", "", true)
					@formField("Company", "company", "text", "", false)
					@formField("Phone", "phone", "text", "", false)
					@formField("Title", "title", "text", "", false)
					@formField("District", "district", "text", "", false)
					<div class="flex gap-3 pt-2">
						<button type="submit"
							class="px-4 py-2 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition-colors">
							Create
						</button>
						<a href="/affiliates"
							class="px-4 py-2 border border-gray-300 text-sm rounded-lg hover:bg-gray-50 transition-colors">
							Cancel
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// USPSRepsData mirrors AffiliatesData.
type USPSRepsData = AffiliatesData

templ USPSReps(d USPSRepsData) {
	@layouts.Dashboard("USPS Reps") {
		<div class="mb-4 flex items-center justify-between">
			<span class="text-sm text-gray-500">USPS Reps</span>
			<div class="flex gap-2">
				<a href="/usps-reps/create"
					class="px-3 py-1.5 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition-colors">
					+ Register Rep
				</a>
				<form method="get" action="/usps-reps">
					<input type="text" name="q" value={ d.Search } placeholder="Search…"
						class="px-3 py-1.5 border border-gray-300 rounded-lg text-sm w-52 focus:outline-none focus:ring-2 focus:ring-indigo-400"/>
				</form>
			</div>
		</div>
		@layouts.LazySection("usps-reps-list", listURL("/usps-reps/list", d.Search))
	}
}

// USPSRepsListFragment is the lazily-loaded table for the USPS reps page.
templ USPSRepsListFragment(d USPSRepsData) {
	<div id="usps-reps-list" class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
		<div class="px-5 py-3 border-b border-gray-100 text-sm text-gray-500">{ fmt.Sprintf("%d reps", d.TotalItems) }</div>
		@userListTable(d.Users, "usps-reps")
		@Pagination("/usps-reps", d.Page, d.Limit, d.TotalItems, d.Search)
	</div>
}

templ CreateUSPSRep(flash, errMsg string) {
	@layouts.Dashboard("Register USPS Rep") {
		<div class="max-w-lg">
			<div class="bg-white rounded-xl border border-gray-200 shadow-sm">
				<div class="px-5 py-4 border-b border-gray-100">
					<h2 class="text-sm font-semibold text-gray-700">Register USPS Rep</h2>
				</div>
				if errMsg != "" {
					<div class="mx-5 mt-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">{ errMsg }</div>
				}
				if flash != "" {
					<div class="mx-5 mt-4 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3">{ flash }</div>
				}
				<form method="post" action="/usps-reps/create" class="px-5 py-4 space-y-4">
					@formField("Name", "name", "text", "", true)
					@formField("Email", "email", "email", "", true)
					@formField("Password", "password", "password", "", true)
					@formField("Title", "title", "text", "", false)
					@formField("District", "district", "text", "", false)
					<div class="flex gap-3 pt-2">
						<button type="submit"
							class="px-4 py-2 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700 transition-colors">
							Register
						</button>
						<a href="/usps-reps"
							class="px-4 py-2 border border-gray-300 text-sm rounded-lg hover:bg-gray-50 transition-colors">
							Cancel
						</a>
					</div>
				</form>
			</div>
		</div>
	}
}

// Shared user list table used by affiliates and reps.
templ userListTable(users []models.User, base string) {
	<div class="overflow-x-auto">
		<table class="min-w-full text-sm">
			<thead class="bg-gray-50 text-xs text-gray-500 uppercase tracking-wide border-b border-gray-200">
				<tr>
					<th class="px-4 py-3 text-left">Name</th>
					<th class="px-4 py-3 text-left">Email</th>
					<th class="px-4 py-3 text-left">Company</th>
					<th class="px-4 py-3 text-left">Rep ID</th>
					<th class="px-4 py-3 text-left">Created</th>
					<th class="px-4 py-3"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-gray-100">
				for _, u := range users {
					<tr class="hover:bg-gray-50 transition-colors">
						<td class="px-4 py-3 font-medium text-gray-800">{ u.Name }</td>
						<td class="px-4 py-3 text-gray-600">{ u.Email }</td>
						<td class="px-4 py-3 text-gray-500">{ strOrDash(u.Company) }</td>
						<td class="px-4 py-3 text-gray-500 font-mono text-xs">{ strOrDash(u.RepID) }</td>
						<td class="px-4 py-3 text-gray-500">{ fmtTime(u.CreatedAt) }</td>
						<td class="px-4 py-3">
							<a href={ templ.URL(fmt.Sprintf("/%s/%d", base, u.ID)) }
								class="text-indigo-600 hover:text-indigo-800 text-xs font-medium">View</a>
						</td>
					</tr>
				}
				if len(users) == 0 {
					<tr>
						<td colspan="6" class="px-4 py-10 text-center text-gray-400">No results found.</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// formField renders a labelled input field.
templ formField(label, name, inputType, defaultVal string, required bool) {
	<div>
		<label class="block text-xs font-medium text-gray-600 mb-1">
			{ label }
			if required {
				<span class="text-red-500 ml-0.5">*</span>
			}
		</label>
		<input
			type={ inputType }
			name={ name }
			value={ defaultVal }
			if required {
				required
			}
			class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
		/>
	</div>
}
